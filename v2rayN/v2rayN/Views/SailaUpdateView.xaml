<UserControl
    x:Class="v2rayN.Views.SailaUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="420">
    <!-- Saila's own update dialog: Saila itself, the Xray core and the geo files; rows are built in code -->
    <Border
        x:Name="card"
        Padding="20"
        Background="#141519"
        BorderBrush="#2A2C33"
        BorderThickness="1"
        CornerRadius="22">
        <StackPanel>
            <TextBlock
                x:Name="txtTitle"
                Margin="0,0,0,14"
                FontSize="17"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Text="Check for update" />

            <StackPanel x:Name="panelRows" />

            <Grid Margin="0,6,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="txtPreRelease"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#FFFFFF"
                    Text="Check pre-release versions of Saila" />
                <ToggleButton
                    x:Name="togPreRelease"
                    Grid.Column="1"
                    AutomationProperties.Name="Check pre-release versions"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </Grid>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="btnClose"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Close"
                    Click="BtnClose_Click"
                    Content="Close"
                    Style="{StaticResource MaterialDesignFlatButton}" />
                <Button
                    x:Name="btnCheckOnly"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Check"
                    Click="BtnCheckOnly_Click"
                    Content="Check"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="18" />
                <Button
                    x:Name="btnUpdate"
                    AutomationProperties.Name="Check and update"
                    Click="BtnUpdate_Click"
                    Content="Check and update"
                    materialDesign:ButtonAssist.CornerRadius="18" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
