<UserControl
    x:Class="v2rayN.Views.SailaBackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="400">
    <!-- Saila's backup dialog: one file with subscriptions, servers and settings (local only, no WebDAV) -->
    <Border
        x:Name="card"
        Padding="20"
        Background="#141519"
        BorderBrush="#2A2C33"
        BorderThickness="1"
        CornerRadius="22">
        <StackPanel>
            <TextBlock
                x:Name="txtTitle"
                Margin="0,0,0,8"
                FontSize="17"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Text="Backup and restore" />
            <TextBlock
                x:Name="txtHint"
                Margin="0,0,0,16"
                FontSize="12"
                Foreground="#94A3B8"
                Text="Save your subscriptions, servers and settings to a file, or bring them back from one. Restoring restarts Saila."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="txtStatus"
                MinHeight="18"
                Margin="0,0,0,14"
                FontSize="13"
                Foreground="#94A3B8"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="btnClose"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Close"
                    Click="BtnClose_Click"
                    Content="Close"
                    Style="{StaticResource MaterialDesignFlatButton}" />
                <Button
                    x:Name="btnRestore"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Restore from file"
                    Click="BtnRestore_Click"
                    Content="Restore from file"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="18" />
                <Button
                    x:Name="btnBackup"
                    AutomationProperties.Name="Backup to file"
                    Click="BtnBackup_Click"
                    Content="Backup to file"
                    materialDesign:ButtonAssist.CornerRadius="18" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
