<UserControl
    x:Class="v2rayN.Views.SailaHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:local="clr-namespace:v2rayN.Views"
    d:DesignHeight="850"
    d:DesignWidth="480"
    mc:Ignorable="d">

    <Grid x:Name="rootGrid">
        <!-- Dynamic Backdrop: Nexus / Glass / Black / White + 32px grid + radial glows -->
        <local:SailaBackdropControl x:Name="backdropControl" />

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Focusable="False">
            <Grid
                MaxWidth="460"
                HorizontalAlignment="Center"
                Margin="18,16,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Top Header -->
                    <RowDefinition Height="Auto" /> <!-- Center Orb -->
                    <RowDefinition Height="Auto" /> <!-- Server Card -->
                    <RowDefinition Height="Auto" /> <!-- Speed Cards -->
                    <RowDefinition Height="Auto" /> <!-- Info Strip -->
                    <RowDefinition Height="Auto" /> <!-- Floating Nav -->
                </Grid.RowDefinitions>

                <!-- 1. Top row: Shield badge + Status + Add button -->
                <Grid Grid.Row="0" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Round shield badge -->
                    <Border
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        x:Name="borderShield"
                        Background="#20FFFFFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <materialDesign:PackIcon
                            x:Name="iconShield"
                            Kind="ShieldCheck"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#94A3B8" />
                    </Border>

                    <!-- Status texts -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Static resx:ResUI.saila_status_connection}"
                            FontSize="11"
                            x:Name="txtStatusLabel"
                            Foreground="#94A3B8" />
                        <TextBlock
                            x:Name="txtConnectionStatus"
                            Text="{x:Static resx:ResUI.saila_not_connected}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF" />
                    </StackPanel>

                    <!-- + Add Pill Button -->
                    <Button
                        Grid.Column="2"
                        x:Name="btnAddServer"
                        Height="36"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="BtnAddServer_Click"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="borderAdd"
                                    Background="{Binding ElementName=btnAddServer, Path=Tag}"
                                    CornerRadius="18"
                                    Padding="14,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon
                                            Kind="Plus"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Foreground="#FFFFFF" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{x:Static resx:ResUI.saila_add}"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Foreground="#FFFFFF"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="menuImport" Style="{StaticResource DefContextMenu}">
                                <MenuItem
                                    x:Name="itemClipboard"
                                    Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                    InputGestureText="Ctrl+V"
                                    Click="ItemClipboard_Click" />
                                <MenuItem
                                    x:Name="itemScan"
                                    Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                    InputGestureText="Ctrl+S"
                                    Click="ItemScan_Click" />
                                <Separator />
                                <MenuItem
                                    x:Name="itemSubSetting"
                                    Header="{x:Static resx:ResUI.menuSubSetting}"
                                    Click="ItemSubSetting_Click" />
                                <MenuItem
                                    x:Name="itemSubUpdate"
                                    Header="{x:Static resx:ResUI.menuSubUpdate}"
                                    Click="ItemSubUpdate_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- 2. Center: Big Round Connect Button + Animated Ring of Dots -->
                <Grid
                    Grid.Row="1"
                    Height="270"
                    Margin="0,6,0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <!-- Particle Dot Rings Animation Canvas -->
                    <local:SailaOrbControl
                        x:Name="orbControl"
                        Width="270"
                        Height="270"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <!-- Outer Dark Lens/Socket Ring -->
                    <Border
                        Width="162"
                        Height="162"
                        CornerRadius="81"
                        x:Name="borderSocket"
                        Background="#70000000"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <!-- Big Round Connect Button -->
                    <Button
                        x:Name="btnMainConnect"
                        Width="134"
                        Height="134"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="BtnToggleConnect_Click"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="borderInnerBtn"
                                    CornerRadius="67"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1.5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Power Icon when disconnected -->
                            <materialDesign:PackIcon
                                x:Name="iconPower"
                                Kind="Power"
                                Width="46"
                                Height="46"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FFFFFF"
                                Visibility="Visible" />

                            <!-- Timer when connected -->
                            <TextBlock
                                x:Name="txtTimer"
                                Text="00:00:00"
                                FontSize="21"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FFFFFF"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- 3. Server Card -->
                <Border
                    Grid.Row="2"
                    x:Name="cardServer"
                    CornerRadius="24"
                    Padding="16"
                    Margin="0,4,0,8"
                    Background="#C016203E"
                    BorderBrush="#3582A0FF"
                    BorderThickness="1">
                    <StackPanel>
                        <!-- Clickable Header Row: Avatar + Name + Subtitle + Chevron -->
                        <Grid
                            x:Name="rowServerHeader"
                            Cursor="Hand"
                            Background="Transparent"
                            MouseLeftButtonUp="RowServerHeader_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar (Country Flag Emoji or Initials) -->
                            <Border
                                Grid.Column="0"
                                Width="46"
                                Height="46"
                                CornerRadius="23"
                                x:Name="borderAvatar"
                                Background="#25FFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="txtAvatar"
                                    Text="SL"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <!-- Server Name & Subtitle -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="txtServerRemarks"
                                    Text="{x:Static resx:ResUI.saila_no_server}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="txtServerSubtitle"
                                    Text="{x:Static resx:ResUI.saila_current_server}"
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    TextTrimming="CharacterEllipsis"
                                    Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Chevron Right -->
                            <materialDesign:PackIcon
                                Grid.Column="2"
                                Kind="ChevronRight"
                                Width="24"
                                Height="24"
                                Foreground="#94A3B8"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Full-width Pill Button "Connect" / "Disconnect" -->
                        <Button
                            x:Name="btnPillConnect"
                            Height="46"
                            Margin="0,14,0,0"
                            Cursor="Hand"
                            Click="BtnToggleConnect_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="borderPill"
                                        CornerRadius="23"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <TextBlock
                                            x:Name="txtPillLabel"
                                            Text="{x:Static resx:ResUI.saila_connect}"
                                            FontWeight="SemiBold"
                                            FontSize="15"
                                            Foreground="#FFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 4. Two Speed Cards: Upload & Download -->
                <Grid Grid.Row="3" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Upload Speed Card -->
                    <Border
                        Grid.Column="0"
                        x:Name="cardUpload"
                        Margin="0,0,6,0"
                        CornerRadius="20"
                        Padding="12,10"
                        Background="#C016203E"
                        BorderBrush="#3582A0FF"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#20FFFFFF"
                                VerticalAlignment="Center">
                                <materialDesign:PackIcon
                                    x:Name="iconUpload"
                                    Kind="ArrowUpBold"
                                    Width="18"
                                    Height="18"
                                    Foreground="#7AB0FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Static resx:ResUI.saila_upload}"
                                    FontSize="11"
                                    Foreground="#94A3B8" />
                                <TextBlock
                                    x:Name="txtSpeedUpload"
                                    Text="0 B/s"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Download Speed Card -->
                    <Border
                        Grid.Column="1"
                        x:Name="cardDownload"
                        Margin="6,0,0,0"
                        CornerRadius="20"
                        Padding="12,10"
                        Background="#C016203E"
                        BorderBrush="#3582A0FF"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#20FFFFFF"
                                VerticalAlignment="Center">
                                <materialDesign:PackIcon
                                    x:Name="iconDownload"
                                    Kind="ArrowDownBold"
                                    Width="18"
                                    Height="18"
                                    Foreground="#7AB0FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Static resx:ResUI.saila_download}"
                                    FontSize="11"
                                    Foreground="#94A3B8" />
                                <TextBlock
                                    x:Name="txtSpeedDownload"
                                    Text="0 B/s"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. Info Strip: Session traffic, Remaining traffic, Days left -->
                <Border
                    Grid.Row="4"
                    x:Name="cardInfoStrip"
                    CornerRadius="20"
                    Padding="14,10"
                    Margin="0,4,0,12"
                    Background="#C016203E"
                    BorderBrush="#3582A0FF"
                    BorderThickness="1">
                    <Grid x:Name="gridInfoStrip">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" x:Name="colRemaining" />
                            <ColumnDefinition Width="*" x:Name="colDays" />
                        </Grid.ColumnDefinitions>

                        <!-- Session Usage -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="txtSessionVal"
                                Text="0 B"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="#7AB0FF"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Static resx:ResUI.saila_session_usage}"
                                FontSize="11"
                                Foreground="#94A3B8"
                                HorizontalAlignment="Center"
                                Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Remaining Traffic -->
                        <StackPanel Grid.Column="1" x:Name="panelRemaining" HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="txtRemainingVal"
                                Text="{x:Static resx:ResUI.saila_unlimited}"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="#7AB0FF"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Static resx:ResUI.saila_remaining_traffic}"
                                FontSize="11"
                                Foreground="#94A3B8"
                                HorizontalAlignment="Center"
                                Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Days Left -->
                        <StackPanel Grid.Column="2" x:Name="panelDays" HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="txtDaysVal"
                                Text="{x:Static resx:ResUI.saila_unlimited}"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="#7AB0FF"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Static resx:ResUI.saila_days_left}"
                                FontSize="11"
                                Foreground="#94A3B8"
                                HorizontalAlignment="Center"
                                Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 6. Floating Pill Bottom Nav: Home / Servers / Settings / Menu -->
                <Border
                    Grid.Row="5"
                    x:Name="cardNav"
                    Height="54"
                    Width="380"
                    HorizontalAlignment="Center"
                    CornerRadius="27"
                    Padding="6,4"
                    Margin="0,6,0,4"
                    Background="#90111A33"
                    BorderBrush="#3582A0FF"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Nav 1: Home (Active/Accent) -->
                        <Button
                            Grid.Column="0"
                            x:Name="btnNavHome"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.saila_home}"
                            Click="BtnNavHome_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        x:Name="borderNavHome"
                                        Background="#7AB0FF">
                                        <materialDesign:PackIcon
                                            Kind="Home"
                                            Width="22"
                                            Height="22"
                                            Foreground="#FFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 2: Servers (Opens Advanced) -->
                        <Button
                            Grid.Column="1"
                            x:Name="btnNavServers"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.saila_servers}"
                            Click="BtnNavServers_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="Transparent">
                                        <materialDesign:PackIcon
                                            Kind="Server"
                                            Width="22"
                                            Height="22"
                                            Foreground="#CBD5E1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 3: Settings (Opens OptionSettingWindow) -->
                        <Button
                            Grid.Column="2"
                            x:Name="btnNavSettings"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.menuSetting}"
                            Click="BtnNavSettings_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="Transparent">
                                        <materialDesign:PackIcon
                                            Kind="CogOutline"
                                            Width="22"
                                            Height="22"
                                            Foreground="#CBD5E1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 4: Menu (Opens Menu Popup) -->
                        <Button
                            Grid.Column="3"
                            x:Name="btnNavMenu"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="Menu"
                            Click="BtnNavMenu_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="Transparent">
                                        <materialDesign:PackIcon
                                            Kind="DotsVertical"
                                            Width="22"
                                            Height="22"
                                            Foreground="#CBD5E1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="menuOptions" Style="{StaticResource DefContextMenu}">
                                    <MenuItem Header="{x:Static resx:ResUI.saila_theme_style}">
                                        <MenuItem x:Name="itemLookNexus" Header="{x:Static resx:ResUI.saila_style_nexus}" Click="Look_Click" Tag="Nexus" />
                                        <MenuItem x:Name="itemLookGlass" Header="{x:Static resx:ResUI.saila_style_glass}" Click="Look_Click" Tag="Glass" />
                                        <MenuItem x:Name="itemLookBlack" Header="{x:Static resx:ResUI.saila_style_black}" Click="Look_Click" Tag="Black" />
                                        <MenuItem x:Name="itemLookWhite" Header="{x:Static resx:ResUI.saila_style_white}" Click="Look_Click" Tag="White" />
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resx:ResUI.saila_accent_color}">
                                        <MenuItem Header="Blue (#7AB0FF)" Click="Accent_Click" Tag="#7AB0FF" />
                                        <MenuItem Header="Purple (#B79CFF)" Click="Accent_Click" Tag="#B79CFF" />
                                        <MenuItem Header="Pink (#FF8CC0)" Click="Accent_Click" Tag="#FF8CC0" />
                                        <MenuItem Header="Red (#FF8A80)" Click="Accent_Click" Tag="#FF8A80" />
                                        <MenuItem Header="Orange (#FFB074)" Click="Accent_Click" Tag="#FFB074" />
                                        <MenuItem Header="Yellow (#FFD54F)" Click="Accent_Click" Tag="#FFD54F" />
                                        <MenuItem Header="Green (#6EE7A0)" Click="Accent_Click" Tag="#6EE7A0" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{x:Static resx:ResUI.menuCheckUpdate}" Click="MenuCheckUpdate_Click" />
                                    <MenuItem Header="{x:Static resx:ResUI.menuBackupAndRestore}" Click="MenuBackupRestore_Click" />
                                    <MenuItem Header="{x:Static resx:ResUI.menuReload}" Click="MenuReload_Click" />
                                    <MenuItem Header="{x:Static resx:ResUI.saila_advanced}" Click="BtnNavServers_Click" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resx:ResUI.menuClose}" Click="MenuClose_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
