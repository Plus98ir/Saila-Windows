<UserControl
    x:Class="v2rayN.Views.SailaServersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    d:DesignHeight="850"
    d:DesignWidth="480"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid MaxWidth="460" HorizontalAlignment="Stretch" Margin="16,14,16,104">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Search Box -->
            <RowDefinition Height="Auto" /> <!-- Subscription Chips -->
            <RowDefinition Height="*" />    <!-- Server List / Empty State -->
        </Grid.RowDefinitions>

        <!-- 1. Header: Back Arrow, Title, Action Buttons -->
        <Grid Grid.Row="0" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back to Home -->
            <Button
                Grid.Column="0"
                x:Name="btnBack"
                Width="38"
                Height="38"
                Cursor="Hand"
                Click="BtnBack_Click"
                Style="{StaticResource MaterialDesignFlatButton}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderBack" Width="38" Height="38" CornerRadius="19" Background="#20FFFFFF">
                            <materialDesign:PackIcon
                                x:Name="iconBack"
                                Kind="ArrowLeft"
                                Width="20"
                                Height="20"
                                Foreground="#FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Title -->
            <TextBlock
                Grid.Column="1"
                x:Name="txtTitle"
                Margin="12,0,0,0"
                Text="{x:Static resx:ResUI.saila_servers}"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                VerticalAlignment="Center" />

            <!-- Header Actions: Test all & Update subscriptions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    x:Name="btnColumns"
                    Width="38"
                    Height="38"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Columns"
                    Cursor="Hand"
                    ToolTip="One or two columns"
                    Click="BtnColumns_Click"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borderColumns" Width="38" Height="38" CornerRadius="19" Background="#20FFFFFF">
                                <materialDesign:PackIcon
                                    x:Name="iconColumns"
                                    Kind="ViewGridOutline"
                                    Width="18"
                                    Height="18"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    x:Name="btnTestAll"
                    Width="38"
                    Height="38"
                    Margin="0,0,8,0"
                    Cursor="Hand"
                    ToolTip="{x:Static resx:ResUI.saila_test_all}"
                    Click="BtnTestAll_Click"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borderTestAll" Width="38" Height="38" CornerRadius="19" Background="#20FFFFFF">
                                <materialDesign:PackIcon
                                    Kind="LightningBoltOutline"
                                    Width="18"
                                    Height="18"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    x:Name="btnUpdateSubs"
                    Width="38"
                    Height="38"
                    Cursor="Hand"
                    ToolTip="{x:Static resx:ResUI.saila_update_subscriptions}"
                    Click="BtnUpdateSubs_Click"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borderUpdateSubs" Width="38" Height="38" CornerRadius="19" Background="#20FFFFFF">
                                <materialDesign:PackIcon
                                    Kind="Sync"
                                    Width="18"
                                    Height="18"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Search Box -->
        <Border
            x:Name="borderSearch"
            Grid.Row="1"
            Height="40"
            CornerRadius="20"
            Background="#20FFFFFF"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            Margin="0,0,0,10"
            Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon
                    x:Name="iconSearch"
                    Kind="Magnify"
                    Width="18"
                    Height="18"
                    Foreground="#94A3B8"
                    VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    x:Name="txtSearch"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#FFFFFF"
                    Background="Transparent"
                    BorderThickness="0"
                    TextChanged="TxtSearch_TextChanged"
                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.saila_search_servers}"
                    materialDesign:HintAssist.Foreground="#94A3B8" />
            </Grid>
        </Border>

        <!-- 3. Subscription Chips Row -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            Margin="0,0,0,10"
            Focusable="False">
            <StackPanel x:Name="panelChips" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- 4. Server List / Empty State -->
        <Grid Grid.Row="3">
            <ScrollViewer
                x:Name="scrollServers"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Focusable="False">
                <ItemsControl x:Name="listServers" Margin="-3,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                AutomationProperties.Name="{Binding CleanRemarks}"
                                AutomationProperties.AutomationId="{Binding Model.IndexId}"
                                Height="Auto"
                                Cursor="Hand"
                                Margin="3,3,3,5"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                PreviewMouseLeftButtonUp="ServerRow_Click"
                                Click="ServerRow_Click"
                                Style="{StaticResource MaterialDesignFlatButton}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            CornerRadius="20"
                                            Padding="12,10"
                                            Background="{Binding CardBgBrush}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="{Binding CardBorderThickness}">
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource DefContextMenu}">
                                                    <MenuItem Header="{x:Static resx:ResUI.saila_edit_server}" Click="MenuEdit_Click" />
                                                    <MenuItem Header="{x:Static resx:ResUI.saila_copy_share}" Click="MenuShare_Click" />
                                                    <Separator />
                                                    <MenuItem Header="{x:Static resx:ResUI.saila_delete_server}" Click="MenuDelete_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar (Flag or Initials) clipped to circle -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="38"
                                                    Height="38"
                                                    CornerRadius="19"
                                                    ClipToBounds="True"
                                                    Background="{Binding AvatarBgBrush}"
                                                    BorderBrush="{Binding AvatarBorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock
                                                            Text="{Binding AvatarText}"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding TextPrimaryBrush}"
                                                            Visibility="{Binding AvatarTextVisibility}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                        <Image
                                                            Source="{Binding FlagImage}"
                                                            Stretch="UniformToFill"
                                                            Width="38"
                                                            Height="38"
                                                            Visibility="{Binding FlagVisibility}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                            <Image.Clip>
                                                                <EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19" />
                                                            </Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                </Border>

                                                <!-- Server Name & Subtitle -->
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding CleanRemarks}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding TextPrimaryBrush}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{Binding SubtitleLine}"
                                                        FontSize="11"
                                                        Foreground="{Binding TextSecondaryBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Ping Chip -->
                                                <Border
                                                    Grid.Column="2"
                                                    CornerRadius="12"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding PingBgBrush}"
                                                    BorderBrush="{Binding PingBorderBrush}"
                                                    BorderThickness="1">
                                                    <TextBlock
                                                        Text="{Binding PingText}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding PingFgBrush}"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel
                x:Name="panelEmpty"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,40,0,0">
                <Border
                    x:Name="borderEmpty"
                    Width="60"
                    Height="60"
                    CornerRadius="30"
                    Background="#20FFFFFF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                    <materialDesign:PackIcon
                        x:Name="iconEmpty"
                        Kind="ServerOff"
                        Width="28"
                        Height="28"
                        Foreground="#94A3B8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    x:Name="txtEmpty"
                    Text="{x:Static resx:ResUI.saila_empty_servers}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#94A3B8"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,0,0,16" />
                <Button
                    x:Name="btnEmptyAdd"
                    Height="38"
                    Padding="20,0"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Click="BtnEmptyAdd_Click"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="19" Background="{Binding ElementName=btnEmptyAdd, Path=Tag}" Padding="20,0">
                                <TextBlock
                                    Text="{x:Static resx:ResUI.saila_add}"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    Foreground="#FFFFFF"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
