<UserControl
    x:Class="v2rayN.Views.SailaSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    d:DesignHeight="950"
    d:DesignWidth="480"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Focusable="False">
        <Grid MaxWidth="460" HorizontalAlignment="Stretch" Margin="16,14,16,104">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Connection Card -->
                <RowDefinition Height="Auto" /> <!-- Appearance Card -->
                <RowDefinition Height="Auto" /> <!-- Subscription Card -->
                <RowDefinition Height="Auto" /> <!-- More Card -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Back Arrow, Title -->
            <Grid Grid.Row="0" Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="38"
                    Height="38"
                    Cursor="Hand"
                    x:Name="btnBack"
                    Click="BtnBack_Click"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borderBack" Width="38" Height="38" CornerRadius="19" Background="#20FFFFFF">
                                <materialDesign:PackIcon
                                    x:Name="iconBack"
                                    Kind="ArrowLeft"
                                    Width="20"
                                    Height="20"
                                    Foreground="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock
                    Grid.Column="1"
                    x:Name="txtTitle"
                    Margin="12,0,0,0"
                    Text="{x:Static resx:ResUI.saila_settings_title}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- 2. Connection Card -->
            <Border
                Grid.Row="1"
                x:Name="cardConnection"
                CornerRadius="22"
                Padding="16"
                Margin="0,0,0,12"
                Background="#C016203E"
                BorderBrush="#3582A0FF"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        x:Name="txtConnectionTitle"
                        Text="{x:Static resx:ResUI.saila_connection}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Margin="0,0,0,14" />

                    <!-- Mode: System Proxy vs TUN -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtModeLabel" Text="{x:Static resx:ResUI.saila_settings_mode}" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock x:Name="txtModeSub" Text="{x:Static resx:ResUI.saila_mode_proxy}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Segmented Mode Buttons -->
                        <Border x:Name="borderModeContainer" Grid.Column="1" CornerRadius="16" Background="#25FFFFFF" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnModeProxy" Height="28" Padding="12,0" Cursor="Hand" Click="BtnModeProxy_Click" Style="{StaticResource MaterialDesignFlatButton}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="borderModeProxy" CornerRadius="14" Background="#7AB0FF" Padding="12,0">
                                                <TextBlock x:Name="txtModeProxy" Text="{x:Static resx:ResUI.saila_mode_proxy}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnModeTun" Height="28" Padding="12,0" Cursor="Hand" Click="BtnModeTun_Click" Style="{StaticResource MaterialDesignFlatButton}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="borderModeTun" CornerRadius="14" Background="Transparent" Padding="12,0">
                                                <TextBlock x:Name="txtModeTun" Text="{x:Static resx:ResUI.saila_mode_tun}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- Port only: neither system proxy nor TUN; apps set Saila's SOCKS/HTTP port themselves -->
                                <Button x:Name="btnModePort" Height="28" Padding="12,0" Cursor="Hand" Click="BtnModePort_Click" Style="{StaticResource MaterialDesignFlatButton}" AutomationProperties.Name="Port only">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="borderModePort" CornerRadius="14" Background="Transparent" Padding="12,0">
                                                <TextBlock x:Name="txtModePort" Text="Port only" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator x:Name="sep1" Background="#20FFFFFF" Margin="0,0,0,12" />

                    <!-- Auto routing (Saila): routing from the user's country -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtAutoRoutingLabel" Text="{x:Static resx:ResUI.saila_auto_routing}" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock x:Name="txtAutoRoutingStatus" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,8,0" />
                        </StackPanel>
                        <ToggleButton
                            Grid.Column="1"
                            x:Name="togAutoRouting"
                            Cursor="Hand"
                            Click="TogAutoRouting_Click" />
                    </Grid>

                    <Separator x:Name="sepAutoRouting" Background="#20FFFFFF" Margin="0,0,0,12" />

                    <!-- Routing -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtRoutingLabel" Grid.Column="0" Text="{x:Static resx:ResUI.saila_settings_routing}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            x:Name="cmbRouting"
                            DisplayMemberPath="Remarks"
                            FontSize="12"
                            Foreground="#FFFFFF"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                            SelectionChanged="CmbRouting_SelectionChanged" />
                    </Grid>

                    <Separator x:Name="sep2" Background="#20FFFFFF" Margin="0,0,0,12" />

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtAutoRunLabel" Grid.Column="0" Text="{x:Static resx:ResUI.saila_auto_run}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <ToggleButton
                            Grid.Column="1"
                            x:Name="togAutoRun"
                            Cursor="Hand"
                            Click="TogAutoRun_Click" />
                    </Grid>

                    <Separator x:Name="sep3" Background="#20FFFFFF" Margin="0,0,0,12" />

                    <!-- Local Port: editable; Enter or leaving the box saves it and reloads the core -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtLocalPortLabel" Text="{x:Static resx:ResUI.saila_local_port}" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock x:Name="txtLocalPortHint" Text="mixed (SOCKS + HTTP) · 1024–65535" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox
                            Grid.Column="1"
                            x:Name="txtLocalPort"
                            Width="80"
                            AutomationProperties.Name="Local port"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#7AB0FF"
                            HorizontalContentAlignment="Center"
                            MaxLength="5"
                            KeyDown="TxtLocalPort_KeyDown"
                            LostFocus="TxtLocalPort_LostFocus"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Appearance Card (after Subscription, as on Android) -->
            <Border
                Grid.Row="3"
                x:Name="cardAppearance"
                CornerRadius="22"
                Padding="16"
                Margin="0,0,0,12"
                Background="#C016203E"
                BorderBrush="#3582A0FF"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        x:Name="txtAppearanceTitle"
                        Text="{x:Static resx:ResUI.saila_appearance}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Margin="0,0,0,14" />

                    <!-- 4 Looks Segmented Buttons -->
                    <TextBlock x:Name="txtLookTitle" Text="{x:Static resx:ResUI.saila_theme_style}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8" />
                    <Border x:Name="borderLookContainer" CornerRadius="18" Background="#20FFFFFF" Padding="3" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="btnLookNexus" Content="{x:Static resx:ResUI.saila_style_nexus}" Click="BtnLook_Click" Tag="Nexus" Height="32" Cursor="Hand" Style="{StaticResource MaterialDesignFlatButton}" />
                            <Button Grid.Column="1" x:Name="btnLookGlass" Content="{x:Static resx:ResUI.saila_style_glass}" Click="BtnLook_Click" Tag="Glass" Height="32" Cursor="Hand" Style="{StaticResource MaterialDesignFlatButton}" />
                            <Button Grid.Column="2" x:Name="btnLookBlack" Content="{x:Static resx:ResUI.saila_style_black}" Click="BtnLook_Click" Tag="Black" Height="32" Cursor="Hand" Style="{StaticResource MaterialDesignFlatButton}" />
                            <Button Grid.Column="3" x:Name="btnLookWhite" Content="{x:Static resx:ResUI.saila_style_white}" Click="BtnLook_Click" Tag="White" Height="32" Cursor="Hand" Style="{StaticResource MaterialDesignFlatButton}" />
                        </Grid>
                    </Border>

                    <!-- 7 Accent Circles -->
                    <TextBlock x:Name="txtAccentTitle" Text="{x:Static resx:ResUI.saila_accent_color}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8" />
                    <StackPanel x:Name="panelAccents" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <Separator x:Name="sep4" Background="#20FFFFFF" Margin="0,0,0,12" />

                    <!-- Language -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtLangLabel" Grid.Column="0" Text="{x:Static resx:ResUI.TbSettingsLanguage}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            x:Name="cmbLanguage"
                            DisplayMemberPath="Display"
                            SelectedValuePath="Value"
                            FontSize="12"
                            Foreground="#FFFFFF"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                            SelectionChanged="CmbLanguage_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Subscription Card -->
            <Border
                Grid.Row="2"
                x:Name="cardSubscription"
                CornerRadius="22"
                Padding="16"
                Margin="0,0,0,12"
                Background="#C016203E"
                BorderBrush="#3582A0FF"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        x:Name="txtSubscriptionTitle"
                        Text="{x:Static resx:ResUI.saila_subscription}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtUALabel" Grid.Column="0" Text="{x:Static resx:ResUI.saila_user_agent_title}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            x:Name="cmbUserAgent"
                            FontSize="12"
                            Foreground="#FFFFFF"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                            SelectionChanged="CmbUserAgent_SelectionChanged">
                            <ComboBoxItem Content="Saila (default)" Tag="Saila" />
                            <ComboBoxItem Content="v2rayN" Tag="v2rayN" />
                            <ComboBoxItem Content="Hiddify" Tag="Hiddify" />
                            <ComboBoxItem Content="Custom" Tag="Custom" />
                        </ComboBox>
                    </Grid>

                    <TextBox
                        x:Name="txtCustomUA"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="#FFFFFF"
                        Visibility="Collapsed"
                        TextChanged="TxtCustomUA_TextChanged"
                        materialDesign:HintAssist.Hint="Custom User-Agent string…" />
                </StackPanel>
            </Border>

            <!-- 5. More Card -->
            <Border
                Grid.Row="4"
                x:Name="cardMore"
                CornerRadius="22"
                Padding="16"
                Margin="0,0,0,12"
                Background="#C016203E"
                BorderBrush="#3582A0FF"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        x:Name="txtMoreTitle"
                        Text="{x:Static resx:ResUI.saila_more}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Margin="0,0,0,12" />

                    <!-- Check Updates Row -->
                    <Button Height="44" Padding="8,0" Cursor="Hand" Click="BtnCheckUpdate_Click" Style="{StaticResource MaterialDesignFlatButton}">
                        <Grid Width="400">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Update" Width="18" Height="18" Foreground="#7AB0FF" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtCheckUpdate" Grid.Column="1" Margin="12,0,0,0" Text="{x:Static resx:ResUI.menuCheckUpdate}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <materialDesign:PackIcon x:Name="iconChev1" Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Separator x:Name="sep5" Background="#20FFFFFF" Margin="0,2,0,2" />

                    <!-- Backup & Restore Row -->
                    <Button Height="44" Padding="8,0" Cursor="Hand" Click="BtnBackupRestore_Click" Style="{StaticResource MaterialDesignFlatButton}">
                        <Grid Width="400">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="BackupRestore" Width="18" Height="18" Foreground="#7AB0FF" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtBackupRestore" Grid.Column="1" Margin="12,0,0,0" Text="{x:Static resx:ResUI.menuBackupAndRestore}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <materialDesign:PackIcon x:Name="iconChev2" Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Separator x:Name="sep7" Background="#20FFFFFF" Margin="0,10,0,14" />

                    <!-- About Info -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="txtAbout"
                            Text="Saila · Based on v2rayN by 2dust and Xray-core · GPL-3.0"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="#94A3B8"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
