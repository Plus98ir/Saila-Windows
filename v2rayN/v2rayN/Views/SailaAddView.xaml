<UserControl
    x:Class="v2rayN.Views.SailaAddView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    d:DesignHeight="850"
    d:DesignWidth="480"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Focusable="False">
        <Grid MaxWidth="460" HorizontalAlignment="Stretch" Margin="16,14,16,104">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Card -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Back Arrow, Title -->
            <Grid Grid.Row="0" Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Back to Home -->
                <Button
                    Grid.Column="0"
                    Width="38"
                    Height="38"
                    Cursor="Hand"
                    x:Name="btnBack"
                    Click="BtnBack_Click"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borderBack" Width="38" Height="38" CornerRadius="19" Background="#20FFFFFF">
                                <materialDesign:PackIcon
                                    x:Name="iconBack"
                                    Kind="ArrowLeft"
                                    Width="20"
                                    Height="20"
                                    Foreground="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Title -->
                <TextBlock
                    Grid.Column="1"
                    x:Name="txtTitle"
                    Margin="12,0,0,0"
                    Text="{x:Static resx:ResUI.saila_add_title}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- 2. Card with Multiline Box & Buttons -->
            <Border
                Grid.Row="1"
                x:Name="cardMain"
                CornerRadius="24"
                Padding="18"
                Background="#C016203E"
                BorderBrush="#3582A0FF"
                BorderThickness="1">
                <StackPanel>
                    <!-- Input Box -->
                    <Border
                        x:Name="borderInput"
                        CornerRadius="16"
                        Background="#25FFFFFF"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1"
                        Padding="12,10">
                        <TextBox
                            x:Name="txtInput"
                            Height="180"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            FontSize="13"
                            Foreground="#FFFFFF"
                            Background="Transparent"
                            BorderThickness="0"
                            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.saila_paste_hint}"
                            materialDesign:HintAssist.Foreground="#94A3B8" />
                    </Border>

                    <!-- Feedback status line -->
                    <TextBlock
                        x:Name="txtFeedback"
                        Text=""
                        Height="22"
                        Margin="0,8,0,4"
                        FontSize="13"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />

                    <!-- Big Add Button -->
                    <Button
                        x:Name="btnAdd"
                        Height="46"
                        Margin="0,6,0,12"
                        Cursor="Hand"
                        Click="BtnAdd_Click"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="borderAdd"
                                    CornerRadius="23"
                                    Background="{TemplateBinding Background}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon
                                            Kind="Plus"
                                            Width="18"
                                            Height="18"
                                            Foreground="#FFFFFF"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Text="{x:Static resx:ResUI.saila_add}"
                                            FontWeight="SemiBold"
                                            FontSize="15"
                                            Foreground="#FFFFFF"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Secondary Action Buttons: Clipboard + QR Scan -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Paste from Clipboard -->
                        <Button
                            Grid.Column="0"
                            x:Name="btnPaste"
                            Height="40"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            Click="BtnPaste_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="borderPaste"
                                        CornerRadius="20"
                                        Background="#25FFFFFF"
                                        BorderBrush="#35FFFFFF"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon
                                                x:Name="iconPaste"
                                                Kind="ClipboardTextOutline"
                                                Width="16"
                                                Height="16"
                                                Foreground="#CBD5E1"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="txtPaste"
                                                Margin="6,0,0,0"
                                                Text="{x:Static resx:ResUI.saila_paste_clipboard}"
                                                FontWeight="SemiBold"
                                                FontSize="12"
                                                Foreground="#CBD5E1"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Scan QR on screen -->
                        <Button
                            Grid.Column="1"
                            x:Name="btnScan"
                            Height="40"
                            Margin="6,0,0,0"
                            Cursor="Hand"
                            Click="BtnScan_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="borderScan"
                                        CornerRadius="20"
                                        Background="#25FFFFFF"
                                        BorderBrush="#35FFFFFF"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon
                                                x:Name="iconScan"
                                                Kind="QrcodeScan"
                                                Width="16"
                                                Height="16"
                                                Foreground="#CBD5E1"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="txtScan"
                                                Margin="6,0,0,0"
                                                Text="{x:Static resx:ResUI.saila_scan_qr}"
                                                FontWeight="SemiBold"
                                                FontSize="12"
                                                Foreground="#CBD5E1"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
