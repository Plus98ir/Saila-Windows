<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Saila"
    Width="1180"
    Height="820"
    MinWidth="440"
    MinHeight="600"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/v2rayN.ico"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStyle="None"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  Saila: no system title bar; the drag strip and the two buttons below replace it.  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <!--  Saila: thin rounded scrollbar without arrows or track; ApplyThemeStyle sets SailaScrollThumb per look.  -->
            <SolidColorBrush x:Key="SailaScrollThumb" Color="#55FFFFFF" />
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6" />
                <Setter Property="MinWidth" Value="6" />
                <Setter Property="Margin" Value="0,4,2,4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource SailaScrollThumb}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="6" />
                        <Setter Property="Width" Value="Auto" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        x:Name="dialogRoot"
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <!-- 1. Saila Flow Shell -->
            <Grid x:Name="panelHome" Visibility="Visible">
                <!-- Dynamic Backdrop: Nexus / Glass / Black / White + 32px grid + radial glows -->
                <view:SailaBackdropControl x:Name="backdropControl" />

                <!-- Pages Container (below the 32px drag strip) -->
                <Grid x:Name="panelPages" Margin="0,32,0,0">
                    <!-- Wide window: home (power button) stays on the left, the other pages open on the right. Narrow: one page at a time. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colHome" Width="480" />
                        <ColumnDefinition x:Name="colPane" Width="*" />
                    </Grid.ColumnDefinitions>
                    <view:SailaHomeView x:Name="viewHome" Grid.Column="0" Visibility="Visible" />
                    <Border x:Name="paneDivider" Grid.Column="1" Width="1" Margin="0,-32,0,0" HorizontalAlignment="Left" />
                    <Grid x:Name="panelRight" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1">
                            <view:SailaServersView x:Name="viewServers" Visibility="Collapsed" />
                            <view:SailaAddView x:Name="viewAdd" Visibility="Collapsed" />
                            <view:SailaSettingsView x:Name="viewSettings" Visibility="Collapsed" />
                            <Grid x:Name="hostEdit" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Drag strip with minimize / close, replacing the Windows title bar -->
                <Grid
                    x:Name="stripTitle"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="StripTitle_MouseLeftButtonDown">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="btnWinPane"
                            Width="40"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Open or close the side panel"
                            Click="BtnWinPane_Click"
                            Cursor="Hand"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:PackIcon x:Name="iconWinPane" Width="16" Height="16" Kind="ArrowCollapseHorizontal" />
                        </Button>
                        <Button
                            x:Name="btnWinMinimize"
                            Width="40"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Minimize"
                            Click="BtnWinMinimize_Click"
                            Cursor="Hand"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:PackIcon x:Name="iconWinMinimize" Width="16" Height="16" Kind="WindowMinimize" />
                        </Button>
                        <Button
                            x:Name="btnWinTray"
                            Width="40"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Hide to tray"
                            Click="BtnWinTray_Click"
                            Cursor="Hand"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Hide next to the clock">
                            <materialDesign:PackIcon x:Name="iconWinTray" Width="16" Height="16" Kind="TrayArrowDown" />
                        </Button>
                        <Button
                            x:Name="btnWinClose"
                            ToolTip="Quit Saila"
                            Width="40"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Quit"
                            Click="BtnWinClose_Click"
                            Cursor="Hand"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:PackIcon x:Name="iconWinClose" Width="16" Height="16" Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Floating Pill Bottom Nav: Home / Servers / Add / Settings / Menu -->
                <Border
                    x:Name="cardNav"
                    Height="54"
                    Width="380"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    CornerRadius="27"
                    Padding="6,4"
                    Margin="0,0,0,16"
                    Background="#90111A33"
                    BorderBrush="#3582A0FF"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Nav 1: Home -->
                        <Button
                            Grid.Column="0"
                            x:Name="btnNavHome"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.saila_home}"
                            Click="BtnNavHome_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="{TemplateBinding Background}">
                                        <materialDesign:PackIcon
                                            Kind="Home"
                                            Width="22"
                                            Height="22"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 2: Servers -->
                        <Button
                            Grid.Column="1"
                            x:Name="btnNavServers"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.saila_servers}"
                            Click="BtnNavServers_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="{TemplateBinding Background}">
                                        <materialDesign:PackIcon
                                            Kind="Server"
                                            Width="22"
                                            Height="22"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 3: Add -->
                        <Button
                            Grid.Column="2"
                            x:Name="btnNavAdd"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.saila_add_title}"
                            Click="BtnNavAdd_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="{TemplateBinding Background}">
                                        <materialDesign:PackIcon
                                            Kind="PlusCircleOutline"
                                            Width="22"
                                            Height="22"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 4: Settings -->
                        <Button
                            Grid.Column="3"
                            x:Name="btnNavSettings"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="{x:Static resx:ResUI.saila_settings_title}"
                            Click="BtnNavSettings_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="{TemplateBinding Background}">
                                        <materialDesign:PackIcon
                                            Kind="CogOutline"
                                            Width="22"
                                            Height="22"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nav 5: Menu -->
                        <Button
                            Grid.Column="4"
                            x:Name="btnNavMenu"
                            Width="44"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="Menu"
                            Click="BtnNavMenu_Click"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="22"
                                        Background="{TemplateBinding Background}">
                                        <materialDesign:PackIcon
                                            Kind="DotsVertical"
                                            Width="22"
                                            Height="22"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="menuOptions" Style="{StaticResource DefContextMenu}">
                                    <MenuItem Header="{x:Static resx:ResUI.menuCheckUpdate}" Click="MenuCheckUpdate_Click" />
                                    <MenuItem Header="{x:Static resx:ResUI.menuBackupAndRestore}" Click="MenuBackupAndRestore_Click" />
                                    <MenuItem Header="{x:Static resx:ResUI.menuReload}" Click="MenuReload_Click" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resx:ResUI.menuClose}" Click="MenuClose_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Advanced View -->
            <DockPanel x:Name="panelAdvanced" Visibility="Collapsed">
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        KeyboardNavigation.TabNavigation="Continue"
                        Style="{StaticResource MaterialDesignToolBar}">
                        <Button
                            x:Name="btnBackToHome"
                            Padding="{StaticResource MarginLeftRight8}"
                            ToolTip="{x:Static resx:ResUI.saila_back_to_saila}"
                            Style="{StaticResource DefButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="ArrowLeft" />
                                <TextBlock Text="{x:Static resx:ResUI.saila_back_to_saila}" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuServers}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Server" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuServers}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuAddServerViaClipboard"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                    InputGestureText="Ctrl+V" />
                                <MenuItem
                                    x:Name="menuAddServerViaScan"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                    InputGestureText="Ctrl+S" />
                                <MenuItem
                                    x:Name="menuAddServerViaImage"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddCustomServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                <MenuItem
                                    x:Name="menuAddPolicyGroupServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                <MenuItem
                                    x:Name="menuAddProxyChainServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                <MenuItem
                                    x:Name="menuAddCustomOutboundServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddVmessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                <MenuItem
                                    x:Name="menuAddVlessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                <MenuItem
                                    x:Name="menuAddShadowsocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                <MenuItem
                                    x:Name="menuAddTrojanServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                <MenuItem
                                    x:Name="menuAddHysteria2Server"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                <MenuItem
                                    x:Name="menuAddWireguardServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                <MenuItem
                                    x:Name="menuAddMasqueServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                <MenuItem
                                    x:Name="menuAddSocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                <MenuItem
                                    x:Name="menuAddHttpServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddTuicServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                <MenuItem
                                    x:Name="menuAddAnytlsServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                <MenuItem
                                    x:Name="menuAddNaiveServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuSubscription}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="BookClockOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuSubscription}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuSubSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubSetting}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuSubUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                <MenuItem
                                    x:Name="menuSubUpdateViaProxy"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                <MenuItem
                                    x:Name="menuSubGroupUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                <MenuItem
                                    x:Name="menuSubGroupUpdateViaProxy"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuSetting}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="SettingsOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuSetting}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuOptionSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                <MenuItem
                                    x:Name="menuRoutingSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                <MenuItem
                                    x:Name="menuDNSSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                <MenuItem
                                    x:Name="menuFullConfigTemplate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                <MenuItem
                                    x:Name="menuGlobalHotkeySetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuRebootAsAdmin"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                <MenuItem
                                    x:Name="menuSettingsSetUWP"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                <MenuItem
                                    x:Name="menuClearServerStatistics"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                <Separator Margin="-40,5" />
                                <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                    <MenuItem
                                        x:Name="menuRegionalPresetsDefault"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsRussia"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsIran"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuBackupAndRestore"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                <MenuItem
                                    x:Name="menuOpenTheFileLocation"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuHelp"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="HelpCircleOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuHelp}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                <Separator Margin="-40,5" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuReload"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuReload}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Reload" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuReload}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}" Visibility="Collapsed">
                            <MenuItem
                                x:Name="menuPromotion"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuPromotion}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="VolumeHigh" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuPromotion}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuClose"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuClose}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Minimize" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuClose}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>

                        <materialDesign:PopupBox
                            Padding="-2"
                            HorizontalAlignment="Right"
                            StaysOpen="True"
                            Style="{StaticResource MaterialDesignToolForegroundPopupBox}">
                            <ContentControl x:Name="pbTheme" />
                        </materialDesign:PopupBox>

                        <Button
                            x:Name="btnNewUpdate"
                            Margin="{StaticResource MarginLeftRight8}"
                            Content="{x:Static resx:ResUI.menuNewUpdate}"
                            Style="{StaticResource DefButton}"
                            Visibility="Hidden" />
                    </ToolBar>
                </ToolBarTray>


                <Grid>
                    <Grid x:Name="gridMain" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain"
                            Grid.Column="2"
                            HorizontalContentAlignment="Left">
                            <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                            <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                            <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                        </TabControl>
                    </Grid>
